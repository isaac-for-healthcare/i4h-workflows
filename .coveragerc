[run]
branch = True
relative_files = True
source =
    common/i4h_common
    tasks/gr00t_n15/i4h_tasks/gr00t_n15
    tasks/gr00t_n16/i4h_tasks/gr00t_n16
    rl/i4h_rl
    tools/dataset/i4h_tools/dataset
    tools/mimic/i4h_tools/mimic
    tools/patient_twin/i4h_tools/patient_twin
    scripts

[report]
precision = 1
show_missing = True
skip_empty = True
omit =
    */tests/*

[xml]
output = coverage.xml
