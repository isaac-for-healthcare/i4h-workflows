+    first = [True]  # one-shot diagnostic on the first real snapshot
+    # Per-step diagnostics for the FIRST few inferences. Answers: (a) do tactile
+    # frames actually change BETWEEN denoise steps, PER FINGER; (b) within one
+    # snapshot, are the fingers mixed-frame (cross-tick skew); (c) for bimanual,
+    # are the hands advancing together; (d) what does the per-step refresh cost?
+    # diag["calls"] collects (t_enter, provider_cost_s, fids) per provider() call
+    # (= one denoise step), where fids maps each finger key -> (frame_id, ts).
+    DIAG_INFERENCES = 3
+    diag = {"inf": -1, "calls": []}
+    inflight = {"fresh": None, "fids": None}  # 'once' mode: per-inference cached snapshot
+
+    def _build_fresh():
+        """Snapshot the live stream and build the model input dict + a per-finger
+        (frame_id, ts) map (for diagnostics)."""
+        snap = sub.snapshot()
+        frames, live = [], 0
+        fids = {}  # f"{hand}_{finger}" -> (frame_id, ts); (-1, None) when absent
+        for hand, finger in finger_specs:
+            fd = snap.get(f"{hand}_ee", {}).get(finger)
+            if fd is not None:
+                frames.append(fd["deform"].astype(np.float32))
+                live += 1
+                fids[f"{hand}_{finger}"] = (fd.get("frame_id", -1), fd.get("ts"))
+            else:
+                frames.append(zero)
+                fids[f"{hand}_{finger}"] = (-1, None)
+        arr = np.stack(frames, axis=0)[None, :, None, :, :]  # (1, N, 1, 240, 240)
+        fresh = {"deform_maps": torch.from_numpy(arr).to(device=dev, dtype=dt)}
+
+        # NOTE: the force window is NOT refreshed here. For a force checkpoint
+        # the obs-carried tactile_force survives the provider merge (the merge
+        # only overrides keys this dict returns), so force stays request-time.
+        # T-Rex force freshness at deploy comes from the client per refine via
+        # the cascade, not from this per-denoise-step provider.
+
+        # Fresh, time-aligned joints (DEGREES on the wire -> radians for the FK),
+        # shaped (1, NUM_JOINTS) to match the collated obs joint_angles_<hand>.
+        # A hand with no live joints is left out -> the action-head merge keeps
+        # that hand's joints from the request observation.
