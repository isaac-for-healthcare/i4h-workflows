@@ -0,0 +1,189 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Spatial anchoring of tactile features (SaTA, arXiv 2510.14647).
+
+Three components, all per Sharpa engineers' replies (2026-05-13):
+
+1. Fourier positional encoding of the 12D pose
+   (3D position in meters + 9D flattened rotation matrix).
+   Deterministic sin/cos at frequencies 2^k for k=0..5 (K=6, no pi multiplier).
+   Output dim: 12 x 2 x 6 = 144.
+
+2. Spatial MLP (shared) -> two separate gamma/beta heads (FiLM).
+   Linear(144, 256) -> ReLU -> Linear(256, 512) -> ReLU -> Linear(512, 512)
+       -> gamma_head: Linear(512, 512)
+       -> beta_head:  Linear(512, 512)
+   Default nn.Linear init. NO identity init.
+
+3. FiLM: features' = gamma * features + beta  (per finger).
+
+4. Per-finger positional embedding: nn.Parameter shape [1, 10, 512],
+   added to all 10 SAT tokens (broadcast). This provides finger identity.
+"""
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+
+# Sharpa-specified constants
+POSE_DIM = 12                                  # 3 pos + 9 rotation matrix entries
+NUM_FREQS = 6                                  # K=6
+FOURIER_OUT_DIM = POSE_DIM * 2 * NUM_FREQS     # 144
+
+SPATIAL_MLP_HIDDEN_1 = 256
+SPATIAL_MLP_HIDDEN_2 = 512
+SPATIAL_MLP_OUT = 512
+
+TACTILE_FEAT_DIM = 512
+DEFAULT_NUM_FINGERS = 10
+
+
+class FourierEncoding(nn.Module):
+    """Deterministic multi-frequency sin/cos encoding.
+
+    sin(x * 2^k) and cos(x * 2^k) for k = 0..K-1.
+    No pi multiplier (per Sharpa: "frequency base is 2^k, not 2^k * pi").
+    No raw pose concatenation.
+    """
+
+    def __init__(self, num_freqs: int = NUM_FREQS):
+        super().__init__()
+        # Pre-compute frequencies as a non-trainable buffer.
+        freqs = torch.tensor([2.0 ** k for k in range(num_freqs)], dtype=torch.float32)
+        self.register_buffer("freqs", freqs, persistent=False)
+        self.num_freqs = num_freqs
+
+    def forward(self, pose: torch.Tensor) -> torch.Tensor:
+        """
+        Args:
+            pose: ``(..., D)`` 12D pose vector(s).
+        Returns:
+            ``(..., D * 2 * K)`` Fourier features.
+        """
+        # pose: (..., D=12)  ->  unsqueeze to (..., D, 1)
+        # freqs: (K,)        ->  broadcast to (..., D, K)
+        scaled = pose.unsqueeze(-1) * self.freqs.to(pose)            # (..., D, K)
+        sin = torch.sin(scaled)                                       # (..., D, K)
+        cos = torch.cos(scaled)                                       # (..., D, K)
+        # Concatenate along the last two axes and flatten.
+        feats = torch.stack([sin, cos], dim=-1)                       # (..., D, K, 2)
+        return feats.flatten(-3)                                      # (..., D*K*2 = 144)
+
+
+class FiLMHead(nn.Module):
+    """Spatial MLP + two separate gamma/beta linear heads.
+
+    Per Sharpa: ``Linear(144, 256) -> ReLU -> Linear(256, 512) -> ReLU
+    -> Linear(512, 512)``, then ``film_gamma_proj`` and ``film_beta_proj``
+    are separate ``Linear(512, 512)`` heads off the shared spatial features.
+    Uses PyTorch default initialization (NOT identity init).
+    """
+
+    def __init__(
+        self,
+        in_dim: int = FOURIER_OUT_DIM,
+        hidden_1: int = SPATIAL_MLP_HIDDEN_1,
+        hidden_2: int = SPATIAL_MLP_HIDDEN_2,
+        out_dim: int = SPATIAL_MLP_OUT,
+        feat_dim: int = TACTILE_FEAT_DIM,
+    ):
+        super().__init__()
+        # Spatial MLP (shared trunk that produces "spatial_features"):
+        self.spatial_mlp = nn.Sequential(
+            nn.Linear(in_dim, hidden_1),
+            nn.ReLU(),
+            nn.Linear(hidden_1, hidden_2),
+            nn.ReLU(),
+            nn.Linear(hidden_2, out_dim),
+        )
+        # Two separate heads for gamma and beta.
+        self.film_gamma_proj = nn.Linear(out_dim, feat_dim)
+        self.film_beta_proj = nn.Linear(out_dim, feat_dim)
+
+    def forward(self, fourier_feats: torch.Tensor):
+        """
+        Args:
+            fourier_feats: ``(..., 144)`` Fourier-encoded pose.
+        Returns:
+            (gamma, beta) each ``(..., feat_dim=512)``.
+        """
+        spatial = self.spatial_mlp(fourier_feats)
+        gamma = self.film_gamma_proj(spatial)
+        beta = self.film_beta_proj(spatial)
+        return gamma, beta
+
+
+class SpatialAnchor(nn.Module):
+    """Combine tactile features with per-finger pose via Fourier + FiLM,
+    then add a learned per-finger identity embedding.
+
+    Shapes:
+        tactile_feats: ``(B, N, 512)`` — Sharpa encoder output per finger.
+        poses:         ``(B, N, 12)``  — fingertip 6-DoF poses (in wrist frame),
+                                          where rotation is a flattened 3x3 matrix.
+        out:           ``(B, N, 512)`` — spatially-anchored tactile tokens (SAT).
+    """
+
+    def __init__(
+        self,
+        num_fingers: int = DEFAULT_NUM_FINGERS,
+        feat_dim: int = TACTILE_FEAT_DIM,
+        num_freqs: int = NUM_FREQS,
+    ):
+        super().__init__()
+        self.num_fingers = num_fingers
+        self.feat_dim = feat_dim
+        self.fourier = FourierEncoding(num_freqs=num_freqs)
+        self.film = FiLMHead(
+            in_dim=POSE_DIM * 2 * num_freqs,
+            feat_dim=feat_dim,
+        )
+        # Per-Sharpa: per-finger embedding is nn.Parameter of shape
+        # [1, num_images, output_dim] = [1, 10, 512], NOT nn.Embedding.
+        self.pos_embed = nn.Parameter(torch.zeros(1, num_fingers, feat_dim))
+        # Initialize the pos_embed with small normal (matches GR00T's existing
+        # nn.Embedding initialization style).
+        nn.init.normal_(self.pos_embed, mean=0.0, std=0.02)
+
+    def reset_tactile_params(self):
+        """Re-initialize the tactile-side params after HF from_pretrained.
+
+        HF's ``from_pretrained`` (with ``low_cpu_mem_usage=True``) creates
+        params on meta device and only materializes those it loads from the
+        checkpoint. Our `nn.init.normal_(pos_embed, std=0.02)` call inside
+        ``__init__`` runs on the meta tensor and is effectively dropped — the
+        materialized pos_embed ends up with uninitialized memory (values up to
+        ~1e28 observed). Same risk for the FiLM Linear layers, though they
+        usually survive thanks to PyTorch's kaiming-uniform default in
+        ``nn.Linear.__init__``. This method re-runs the safe inits explicitly.
+        """
+        nn.init.normal_(self.pos_embed, mean=0.0, std=0.02)
+        for m in self.film.modules():
+            if isinstance(m, nn.Linear):
+                nn.init.kaiming_uniform_(m.weight, a=5 ** 0.5)
+                if m.bias is not None:
+                    fan_in = m.weight.shape[1]
+                    bound = 1.0 / (fan_in ** 0.5)
+                    nn.init.uniform_(m.bias, -bound, bound)
+
+    def forward(self, tactile_feats: torch.Tensor, poses: torch.Tensor) -> torch.Tensor:
+        if tactile_feats.shape[:-1] != poses.shape[:-1]:
+            raise ValueError(
+                f"tactile_feats and poses must agree on batch+finger dims: "
+                f"{tuple(tactile_feats.shape)} vs {tuple(poses.shape)}"
+            )
+        if tactile_feats.shape[-1] != self.feat_dim:
+            raise ValueError(
+                f"tactile_feats last dim {tactile_feats.shape[-1]} != "
+                f"expected feat_dim {self.feat_dim}"
+            )
+        if poses.shape[-1] != POSE_DIM:
+            raise ValueError(
+                f"poses last dim {poses.shape[-1]} != expected POSE_DIM {POSE_DIM}"
+            )
+
+        fourier_feats = self.fourier(poses)             # (B, N, 144)
+        gamma, beta = self.film(fourier_feats)          # each (B, N, 512)
+        sat = gamma * tactile_feats + beta              # (B, N, 512)  -- FiLM
+        return sat + self.pos_embed                     # broadcast per-finger embedding
