+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Frozen wrapper around the SharpaWave deform encoder.
+
+The encoder class comes from Sharpa's public package
+``sharpawave_deform_encoder`` (github.com/sharpa-robotics/sharpawave-deform-encoder,
+Apache-2.0); nothing of it is copied here. We use the encoder half only; the
+autoencoder's decoder is unused. Per Sharpa: the SaTA tactile feature is the
+encoder output, a (B, 512, 1, 1) tensor that we flatten to (B, 512).
+
+Weights load from either the public SafeTensors checkpoint
+(``sharpawave_deform_autoencoder.safetensors`` on Hugging Face) or a ``.pth``
+state dict; in both the encoder tensors carry the ``deform_encoder.`` prefix.
+The two are not interchangeable models: the public checkpoint is a separate
+training run of the same architecture, so its features differ from those of
+Sharpa's internal weights that the checkpoints finetuned so far were trained
+with. A finetuned GR00T checkpoint carries its own copy of the encoder
+weights, which ``from_pretrained`` restores over whatever this module loaded.
+
+Input preprocessing (verified by inspecting Sharpa's sample images and per
+Sharpa's reply 2026-05-13): raw uint8 cast to float32, no /255, no mean/std
+normalization. The encoder was trained on this distribution.
+
+Image size: this encoder consumes the SharpaWave SDK's **240x240 single-channel
+deformation map** per fingertip. The SaTA paper's "320x240 RGB tactile image" is
+the *raw camera frame*; the SDK converts it into the 240x240 deformation map
+upstream of this module. forward() asserts the 240x240 size so a wrong-sized
+input fails fast instead of silently producing garbage features.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Optional
+
+import torch
+from torch import nn
+
+try:
+    from sharpawave_deform_encoder import DeformEncoder
+except ImportError as e:  # pragma: no cover
+    raise ImportError(
+        "The SharpaWave deform encoder package is required for the tactile path. "
+        "Put a checkout of https://github.com/sharpa-robotics/sharpawave-deform-encoder "
+        "on PYTHONPATH (it ships no pyproject, so it is imported by path) and install "
+        "its requirements (timm, safetensors)."
+    ) from e
+
+
+class SharpaTactileEncoder(nn.Module):
+    """Per-fingertip feature extractor, frozen.
+
+    Args:
+        ckpt_path: path to the encoder weights: the public
+            ``sharpawave_deform_autoencoder.safetensors`` or a ``.pth`` state
+            dict with the same ``deform_encoder.*`` keys. If ``None``, the
+            encoder is left at random init (smoke-test mode).
+
+    Shapes:
+        in:  ``(B, N, 1, 240, 240)`` where N is the number of fingertips (10 for bimanual).
+             Single-channel grayscale deformation maps, float32 in [0, ~255].
+        out: ``(B, N, 512)`` per-finger feature tokens.
+    """
+
+    OUT_DIM = 512
+
+    def __init__(self, ckpt_path: Optional[str | Path] = None):
+        super().__init__()
+        # The encoder half only; the public package's decoder is never built.
+        self._encoder = DeformEncoder()
+
+        if ckpt_path is not None:
+            self._load_encoder_weights(ckpt_path)
+
+        # Freeze and put into eval mode permanently.
+        for p in self._encoder.parameters():
+            p.requires_grad = False
+        self._encoder.eval()
+
+    def _load_encoder_weights(self, ckpt_path: str | Path) -> None:
+        """Load ONLY the ``deform_encoder.*`` keys from a full autoencoder checkpoint.
+
+        The checkpoint also contains the decoder (and, in Sharpa's training
+        checkpoints, a distillation teacher and per-finger calibration
+        buffers). Those are training artifacts; we drop them.
+        """
+        if str(ckpt_path).endswith(".safetensors"):
+            from safetensors.torch import load_file
+
+            sd = load_file(str(ckpt_path), device="cpu")
+        else:
+            ckpt = torch.load(ckpt_path, map_location="cpu", weights_only=False)
+            sd = ckpt.get("state_dict", ckpt) if isinstance(ckpt, dict) else ckpt
+        if not isinstance(sd, dict):
+            raise ValueError(f"Checkpoint at {ckpt_path} did not yield a state_dict")
+
+        # Keys in the checkpoint are like "deform_encoder.<name>"; strip that
+        # prefix and load into self._encoder (the package's DeformEncoder).
+        prefix = "deform_encoder."
+        encoder_sd = {
+            k[len(prefix):]: v for k, v in sd.items()
+            if k.startswith(prefix)
+        }
+        missing, unexpected = self._encoder.load_state_dict(encoder_sd, strict=False)
+        # Some BN tracked stats may legitimately be missing; warn loudly only on weight tensors.
+        unexpected_significant = [k for k in unexpected if not k.endswith("num_batches_tracked")]
+        if unexpected_significant:
+            raise RuntimeError(
+                f"Unexpected keys when loading Sharpa encoder: {unexpected_significant[:5]}..."
+            )
+        if missing:
+            # BN running_mean/running_var/num_batches_tracked may be missing from a clean
+            # state dict — that's fine, they start at PyTorch defaults.
+            missing_significant = [k for k in missing if "running_" not in k and "num_batches_tracked" not in k]
+            if missing_significant:
+                raise RuntimeError(
+                    f"Missing weight keys when loading Sharpa encoder: {missing_significant[:5]}..."
+                )
+
+    def train(self, mode: bool = True):  # type: ignore[override]
+        """Frozen module: ignore train() calls, stay in eval mode always."""
+        return super().train(False)
+
+    @torch.no_grad()
+    def forward(self, deform_maps: torch.Tensor) -> torch.Tensor:
+        """Encode per-fingertip deformation maps to feature vectors.
+
+        ConvNeXt V2's GRN block does an L2-norm reduction that underflows to
+        NaN under bf16. The encoder is frozen (no backward), so we cast it to
+        fp32 lazily on first call (after DeepSpeed / HF Trainer have finished
+        their own bf16 cast of the rest of the model) and run forward in fp32.
+
+        Args:
+            deform_maps: ``(B, N, 1, 240, 240)``. N = number of fingertips.
+
+        Returns:
+            ``(B, N, 512)`` per-finger features in ``deform_maps.dtype``.
+        """
+        if (
+            deform_maps.dim() != 5
+            or deform_maps.shape[2] != 1
+            or deform_maps.shape[3] != 240
+            or deform_maps.shape[4] != 240
+        ):
+            raise ValueError(
+                f"Expected deform_maps of shape (B, N, 1, 240, 240), got {tuple(deform_maps.shape)}. "
+                "This encoder consumes the SharpaWave SDK's 240x240 single-channel "
+                "deformation map, NOT the raw 320x240 RGB tactile camera frame "
+                "(the SDK converts the latter into the former upstream)."
+            )
+        B, N, C, H, W = deform_maps.shape
+
+        # Lazy in-place cast of encoder weights to fp32 if they aren't already.
+        # Idempotent after the first forward — `nn.Module.float()` is a no-op
+        # when params are already fp32.
+        enc_dtype = next(self._encoder.parameters()).dtype
+        if enc_dtype != torch.float32:
+            self._encoder.float()
+
+        flat = deform_maps.reshape(B * N, C, H, W)
+        out_dtype = deform_maps.dtype
+        with torch.amp.autocast(device_type=flat.device.type, enabled=False):
+            # The two public submodules directly rather than DeformEncoder.forward:
+            # its input validation includes a finiteness check, a device->host
+            # sync on every call, and this runs once per denoising step when the
+            # live tactile provider is active. Shape and dtype are enforced above.
+            enc = self._encoder
+            feat = enc.convnext_encoder(enc.downsample_layer(flat.float()))  # (B*N, 512, 1, 1)
+        feat = feat.flatten(1).to(out_dtype)                   # (B*N, 512)
+        return feat.reshape(B, N, self.OUT_DIM)
