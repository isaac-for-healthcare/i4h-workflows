+        |                                |
+        v                                v
+    Sharpa encoder (frozen)        ┌─ Forward kinematics ─┐
+        |                          v                       |
+    f_i ∈ (B, 10, 512)        pose_i ∈ (B, 10, 12)         |
+        |                          |                       |
+        |    ┌───────── SpatialAnchor ────────┐            |
+        |    │  Fourier(144) → FiLM γ,β       │            |
+        +----┤  + per-finger embedding         ├-- SAT tokens
+             └────────────────────────────────┘
+
+Run this file as a script to smoke-test on random tensors (no ckpt / URDF
+needed; uses placeholder mode with explanatory output).
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Optional
+
+import torch
+from torch import nn
+
+from .sharpa_encoder import SharpaTactileEncoder
+from .spatial_anchor import SpatialAnchor, TACTILE_FEAT_DIM, DEFAULT_NUM_FINGERS
+from .trex_force_encoder import TRexForceEncoder
+
+
+class SATEncoder(nn.Module):
+    """Full SaTA encoder: image + kinematics -> spatially-anchored tokens.
+
+    Args:
+        sharpa_ckpt_path: path to Sharpa's HB1 DeformAE_light checkpoint. If
+            None, the encoder is left at random init (useful for smoke-testing
+            without the real weights).
+        fk: A pre-built ``SharpaWaveFK`` instance, or ``None`` if FK is
+            computed externally and pre-stored poses will be passed in.
+        num_fingers: total number of fingertips (10 for bimanual).
+        feat_dim: per-finger feature dim (512 for HB1 DeformAE_light).
+        use_tactile_force: when True, build the frozen pretrained T-Rex force
+            VQ-VAE encoder (``TRexForceEncoder``) and fuse its per-finger force
+            feature into the SAT token via TRUE CONCAT on the feature axis: the
+            fused token is ``[sat (feat_dim) ; force z_q (Df)]`` of width
+            ``feat_dim + Df`` -- NOT projected back to feat_dim. The DiT tactile
+            cross-attention KV dim is widened to match; day-0 unchanged behavior
+            is enforced by the zero-init of the DiT tactile cross-attention
+            OUTPUT projection (``attn_tactile.to_out`` in
+            gr00t/model/modules/dit.py), which gates the whole tactile token
+            (deform + force) to zero at init. When False (default), the force
+            branch is absent and behavior is unchanged.
+        trex_vqvae_ckpt_path: path to T-Rex ``model.pt`` for the VQ-VAE encoder.
+            None -> random-init VQ-VAE (smoke tests and deploy-time
+            construction only -- Gr00tPolicy nulls the path so that
+            ``from_pretrained`` restores the finetuned checkpoint's saved
+            weights).
+        trex_vqvae_config: optional dict of TactileVQVAEConfig overrides.
+        trex_stats_hand_offset: hand slice of the 60-d tacf6 stats (0=left).
+
+    Forward signatures (two modes):
+        Mode A (compute FK internally):
+            sat_tokens = sat_encoder(deform_maps, joint_angles_left=..., joint_angles_right=...)
+        Mode B (FK pre-computed externally):
+            sat_tokens = sat_encoder(deform_maps, poses=...)
+    Pass ``tactile_force=(B, N, W, 6)`` to either mode to fuse force.
+    """
+
+    def __init__(
+        self,
+        sharpa_ckpt_path: Optional[str | Path] = None,
+        fk: Optional[nn.Module] = None,
+        num_fingers: int = DEFAULT_NUM_FINGERS,
+        feat_dim: int = TACTILE_FEAT_DIM,
+        use_tactile_force: bool = False,
+        trex_vqvae_ckpt_path: Optional[str | Path] = None,
+        trex_vqvae_config: Optional[dict] = None,
+        trex_stats_hand_offset: int = 0,
+    ):
+        super().__init__()
+        self.sharpa = SharpaTactileEncoder(ckpt_path=sharpa_ckpt_path)
+        self.fk = fk  # may be None — caller can pass poses directly to forward()
+        self.spatial_anchor = SpatialAnchor(num_fingers=num_fingers, feat_dim=feat_dim)
+        self.num_fingers = num_fingers
+        self.feat_dim = feat_dim
+        self.use_tactile_force = use_tactile_force
+        # Force encoder: the frozen pretrained T-Rex force VQ-VAE (emits z_q).
+        # Built only when use_tactile_force=True. Day-0 unchanged behavior is
+        # enforced by the zero-init DiT tactile cross-attn OUTPUT projection
+        # (gr00t/model/modules/dit.py), NOT by the encoder.
+        if use_tactile_force:
+            self.force_encoder = TRexForceEncoder(
+                num_fingers=num_fingers,
+                ckpt_path=trex_vqvae_ckpt_path,
+                vqvae_config=trex_vqvae_config,
+                stats_hand_offset=trex_stats_hand_offset,
+            )
+            # Per-finger force feature width. The fused token is (feat_dim + Df)
+            # wide; the DiT tactile cross-attention KV dim must be widened to
+            # this value (threaded via the model config). No projection here --
+            # TRUE concat keeps the force channels distinct.
+            self.force_feat_dim = self.force_encoder.embed_dim
+        else:
+            self.force_encoder = None
+            self.force_feat_dim = 0
+
+    @property
+    def fused_tactile_dim(self) -> int:
+        """Width of the fused per-finger tactile token fed to the DiT cross-attn.
+
+        ``feat_dim`` when force is off; ``feat_dim + force_feat_dim`` when the
+        concat force fusion is active.
+        """
+        return self.feat_dim + self.force_feat_dim
+
+    def forward(
+        self,
+        deform_maps: torch.Tensor,
+        joint_angles_left: Optional[torch.Tensor] = None,
+        joint_angles_right: Optional[torch.Tensor] = None,
+        poses: Optional[torch.Tensor] = None,
+        tactile_force: Optional[torch.Tensor] = None,
+    ) -> torch.Tensor:
+        """Compute SAT tokens.
+
+        Args:
+            deform_maps: ``(B, 10, 1, 240, 240)`` per-finger deformation maps,
+                float32 (uint8 cast, no normalization).
+            joint_angles_left, joint_angles_right: per-hand joint angles
+                ``(B, dof)`` -- required if self.fk is set (Mode A).
+            poses: ``(B, 10, 12)`` pre-computed fingertip poses -- used if
+                provided (Mode B), takes precedence over FK.
+            tactile_force: ``(B, N, W, 6)`` per-finger force window. When
+                provided AND ``use_tactile_force`` is set, the T-Rex force
+                feature is CONCATenated onto the SAT token. ``None`` or
+                ``use_tactile_force=False`` -> deform-only behavior (unchanged).
+
+        Returns:
+            SAT tokens ``(B, N, feat_dim)``, or
+            ``(B, N, feat_dim + force_feat_dim)`` when the force fusion is
+            active.
+        """
+        # Fail fast on a finger-count mismatch: deform_maps must carry exactly
+        # self.num_fingers fingertips (== SpatialAnchor pos_embed size == FK
+        # output count). A single-hand run that forgot --num_tactile_tokens 5
+        # (default 10), or a dataset with the wrong number of tactile keys,
+        # would otherwise broadcast-mismatch deep in spatial anchoring.
+        if deform_maps.dim() >= 2 and deform_maps.shape[1] != self.num_fingers:
+            raise ValueError(
+                f"deform_maps has {deform_maps.shape[1]} fingertips but this "
+                f"SATEncoder is configured for num_fingers={self.num_fingers}. "
+                f"They must match (set --num_tactile_tokens to the number of "
+                f"fingertips: 5 per hand)."
+            )
+
+        # 1) Encode tactile images.
+        feats = self.sharpa(deform_maps)                            # (B, 10, 512)
+
+        # 2) Get poses.
+        if poses is None:
+            if self.fk is None:
+                raise ValueError(
+                    "SATEncoder requires either a built-in `fk` module or "
+                    "externally-computed `poses`."
+                )
+            if joint_angles_left is None and joint_angles_right is None:
+                raise ValueError(
+                    "When using internal FK, at least one of joint_angles_left / "
+                    "joint_angles_right must be provided."
+                )
+            with torch.no_grad():
+                poses = self.fk(joint_angles_left, joint_angles_right)   # (B, 10, 12)
+                poses = poses.to(dtype=feats.dtype)
+
+        # 3) Spatial anchoring (Fourier + FiLM + per-finger embedding).
+        sat = self.spatial_anchor(feats, poses)                     # (B, N, 512)
+
+        # 4) Optionally fuse the per-finger force feature via TRUE CONCAT on the
+        #    feature axis: fused token = [sat (feat_dim) ; force_feat (Df)] of
+        #    width feat_dim + Df (NOT projected back). Force finger k concatenates
+        #    with deform finger k -- this relies on the force encoder emitting
+        #    per-finger z_q in the SAME finger order as the deform SAT tokens
+        #    (thumb->pinky; T-Rex left slice 0:30). Day-0 unchanged behavior is
+        #    enforced downstream by the zero-init DiT tactile cross-attn OUTPUT
+        #    projection (dit.py). Skipped when force is off or no force tensor
+        #    given.
+        if self.use_tactile_force and self.force_encoder is not None and tactile_force is not None:
+            force_feat = self.force_encoder(tactile_force)          # (B, N, Df)
+            sat = torch.cat([sat, force_feat.to(sat.dtype)], dim=-1)  # (B, N, feat+Df)
+        return sat
+
+
+# -----------------------------------------------------------------------------
+# Smoke test: `python -m gr00t.model.modules.tactile.sat_encoder`
+# -----------------------------------------------------------------------------
+def _smoke_test():
+    """Exercise the full pipeline on random tensors and print shape checks.
+
+    Does NOT load Sharpa weights or compute real FK -- those require an actual
+    checkpoint and pytorch_kinematics respectively. The point is to verify the
+    shape pipeline and that the modules wire together correctly.
+    """
+    print("=" * 70)
+    print("SATEncoder smoke test")
+    print("=" * 70)
+
+    B = 2
+    num_fingers = 10
+
+    # 1) Mode B: pre-computed poses, no FK module.
+    print("\n[Mode B: external poses, no FK]")
+    sat = SATEncoder(sharpa_ckpt_path=None, fk=None, num_fingers=num_fingers)
+    print(f"  trainable params: {sum(p.numel() for p in sat.parameters() if p.requires_grad)/1e6:.3f} M")
+    print(f"  frozen params:    {sum(p.numel() for p in sat.parameters() if not p.requires_grad)/1e6:.3f} M")
+
+    deform_maps = torch.randn(B, num_fingers, 1, 240, 240) * 30  # roughly matches deform range
+    poses = torch.randn(B, num_fingers, 12)
+
+    sat_tokens = sat(deform_maps, poses=poses)
+    print(f"  deform_maps    in: {tuple(deform_maps.shape)}")
+    print(f"  poses          in: {tuple(poses.shape)}")
+    print(f"  SAT tokens    out: {tuple(sat_tokens.shape)}")
+    assert sat_tokens.shape == (B, num_fingers, 512), sat_tokens.shape
+
+    # 2) Inspect intermediate shapes.
+    print("\n[Component-level shape sanity]")
+    feats = sat.sharpa(deform_maps)
+    print(f"  Sharpa encoder output:       {tuple(feats.shape)}")
+    fourier = sat.spatial_anchor.fourier(poses)
+    print(f"  Fourier features:            {tuple(fourier.shape)}  (expected (B, 10, 144))")
+    gamma, beta = sat.spatial_anchor.film(fourier)
+    print(f"  FiLM gamma:                  {tuple(gamma.shape)}")
+    print(f"  FiLM beta:                   {tuple(beta.shape)}")
+    print(f"  per-finger pos_embed:        {tuple(sat.spatial_anchor.pos_embed.shape)}")
+
+    # 3) Check freeze: Sharpa encoder params are frozen, everything else trainable.
+    print("\n[Trainability]")
+    frozen_groups = {"sharpa": 0, "fourier_buffer": 0}
+    trainable_groups = {"spatial_anchor": 0}
+    for name, p in sat.named_parameters():
+        if "sharpa" in name:
+            assert not p.requires_grad, f"{name} should be frozen"
+            frozen_groups["sharpa"] += p.numel()
+        else:
+            assert p.requires_grad, f"{name} should be trainable"
+            trainable_groups["spatial_anchor"] += p.numel()
+    print(f"  frozen   sharpa params:     {frozen_groups['sharpa']/1e6:.3f} M")
+    print(f"  trainable spatial-anchor:   {trainable_groups['spatial_anchor']/1e6:.3f} M")
+
+    # 4) Backward through trainable params only.
+    print("\n[Gradient sanity check]")
+    loss = sat_tokens.sum()
+    loss.backward()
+    grads_in_trainable = sum(
+        1 for n, p in sat.named_parameters() if p.requires_grad and p.grad is not None
+    )
+    grads_in_frozen = sum(
+        1 for n, p in sat.named_parameters() if (not p.requires_grad) and p.grad is not None
+    )
+    print(f"  trainable params with grad: {grads_in_trainable}")
+    print(f"  frozen   params with grad:  {grads_in_frozen} (must be 0)")
+    assert grads_in_frozen == 0
+
+    print("\nSmoke test passed.")
+
+
+if __name__ == "__main__":
+    _smoke_test()
