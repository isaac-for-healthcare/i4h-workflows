+        per_finger_windows = []
+        for key in tactile_keys:
+            if key not in content.tactile:
+                raise KeyError(
+                    f"Tactile key '{key}' missing from content.tactile (available: "
+                    f"{list(content.tactile.keys())})"
+                )
+            frames = content.tactile[key]
+            if len(frames) == 0:
+                raise ValueError(f"Tactile key '{key}' has empty frame list")
+            per_frame = []
+            for frame in frames:  # one per delta_index (chronological t .. t+K)
+                if frame.ndim == 3:
+                    # (H, W, C) -- collapse to grayscale if needed.
+                    if frame.shape[-1] == 1:
+                        frame = frame.squeeze(-1)
+                    else:
+                        # If somehow 3-channel was stored, take first channel (Sharpa
+                        # encodes deform as 1-channel; multi-channel would indicate
+                        # an upstream pipeline bug -- warn loudly via shape check below).
+                        frame = frame[..., 0]
+                per_frame.append(frame)
+            per_finger_windows.append(np.stack(per_frame, axis=0))  # (T, H, W)
+
+        deform_maps_np = np.stack(per_finger_windows, axis=0)  # (N, T, H, W)
+        deform_maps_np = deform_maps_np[:, :, None, :, :]       # (N, T, 1, H, W)
+
+        # 2-version delay augmentation: emit ONLY the @t frame and the @(t+delta)
+        # frame (2 frames), not the full future window, so the GPU-resident tactile
+        # is 2 frames regardless of the loader window length. delta is shared with
+        # force (sampled once per sample). Clamp to the frames actually loaded.
+        if delay_delta is not None:
+            T = deform_maps_np.shape[1]
+            d = min(int(delay_delta), T - 1)  # never index past the loaded window.
+            deform_t = deform_maps_np[:, 0]        # (N, 1, H, W) -- @t
+            deform_shift = deform_maps_np[:, d]    # (N, 1, H, W) -- @(t+delta)
+            out: dict[str, torch.Tensor] = {
+                "deform_maps": torch.from_numpy(deform_t.astype(np.float32)),
+                "deform_maps_shifted": torch.from_numpy(deform_shift.astype(np.float32)),
+                "delay_delta": torch.tensor(d, dtype=torch.long),
+            }
