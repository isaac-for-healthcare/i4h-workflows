+# SPDX-License-Identifier: Apache-2.0
+"""T-Rex PRETRAINED force VQ-VAE encoder (frozen), as a drop-in force feature.
+
+Wraps T-Rex's pretrained tactile force VQ-VAE (encoder + EMA quantizer) from
+the public T-Rex repository (github.com/ZhuoyangLiu2005/T-Rex, MIT; its
+``tactile_vqvae`` package is imported by path, nothing is copied here) and
+emits the QUANTIZED codebook vectors z_q as a per-finger continuous force
+feature. The decoder the public class builds is replaced by an identity, so
+the module's state dict holds the encoder and quantizer only.
+
+    raw force window (B, N, W, 6)
+        |
+        +-- T-Rex per-axis normalization: 2*(x-min)/(max-min+eps)-1
+        |   using T-Rex's tacf6 stats (this hand's slice of the 60-d vector).
+        |
+        +-- reshape to T-Rex per-hand layout [B, T=W, 5, 6]
+        |
+        +-- FROZEN F6PerFingerEncoder -> z_e [B, 5, embed_dim]
+        +-- FROZEN VQEMAQuantizer (nearest-code) -> z_q [B, 5, embed_dim]
+        v
+    per-finger force feature (B, N, embed_dim)   (continuous, NOT integer ids)
+
+The whole VQ-VAE is frozen (no grad). The downstream SAT fusion concatenates
+z_q onto the deform SAT token; day-0 unchanged behavior is enforced by the
+zero-init of the DiT tactile cross-attention OUTPUT projection
+(``attn_tactile.to_out`` in ``gr00t/model/modules/dit.py``), not here.
+
+GRANULARITY: the pretrained checkpoint
+``miniFranka/T-Rex_midtrain_mecka23k_ucb100_vqvae_epoch6`` uses
+``granularity="finger"`` -> 5 force tokens per hand. The per-hand ("hand")
+granularity is also supported by the VQ-VAE; if used, the single per-hand
+code is broadcast across all fingers (see forward()).
+
+NORMALIZATION (critical): T-Rex's encoder expects RAW force and normalizes
+internally with T-Rex stats here. The data processor therefore passes the
+force window through RAW (float32 cast only) -- see
+``processing_gr00t_n1d7.py::_get_tactile_force_inputs``.
+
+PHYSICAL-CONVENTION ASSUMPTION (user-confirmed pending T-Rex author): the f6
+6-axis convention (axis order, sign, units) is assumed to MATCH between our
+SharpaWave hand and T-Rex -- i.e. NO axis reordering and NO unit conversion is
+applied before feeding the T-Rex normalization. Revisit if the author says the
+conventions differ.
+
+Run ``python -m gr00t.model.modules.tactile.trex_force_encoder`` for a smoke
+test (random-init VQ-VAE, no checkpoint).
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Optional
+
+import torch
+from torch import nn
+
+try:
+    from tactile_vqvae.models.tactile_vqvae import TactileVQVAE, TactileVQVAEConfig
+except ImportError as e:  # pragma: no cover
+    raise ImportError(
+        "T-Rex's tactile_vqvae package is required for the force path. Put a "
+        "checkout of https://github.com/ZhuoyangLiu2005/T-Rex on PYTHONPATH (its "
+        "modules are imported by path, as T-Rex's own scripts do)."
+    ) from e
+
+# Per-finger wrench axes: 3 force + 3 torque (T-Rex f6).
+FORCE_AXES = 6
+# T-Rex codebook embedding dim for the published checkpoint.
+DEFAULT_TREX_EMBED_DIM = 256
+# T-Rex codebook size for the published checkpoint.
+DEFAULT_TREX_CODEBOOK_SIZE = 64
+# T-Rex fingers per hand.
+TREX_FINGERS_PER_HAND = 5
+
+# Authoritative VQ-VAE config from the published checkpoint's training_args.json
+# (miniFranka/T-Rex_midtrain_mecka23k_ucb100_vqvae_epoch6). Used as defaults so
+# the architecture matches the pretrained weights exactly. Override via the
+# ``vqvae_config`` ctor arg if a different checkpoint is used.
+DEFAULT_TREX_VQVAE_CONFIG = {
+    "window": 16,
+    "in_channels": 30,
+    "hidden_channels": 128,
+    "bottleneck_channels": 256,
+    "embed_dim": DEFAULT_TREX_EMBED_DIM,
+    "n_strided_blocks": 2,
+    "codebook_size": DEFAULT_TREX_CODEBOOK_SIZE,
+    "commitment_weight": 0.25,
+    "decay": 0.99,
+    "granularity": "finger",
+    "n_fingers": TREX_FINGERS_PER_HAND,
+    "per_finger_dim": FORCE_AXES,
+}
+
+# T-Rex tacf6 normalization stats from the checkpoint's stats_data.json
+# (midtrain.tactile_f6.q01 / q99). Length 60 = 2 hands x 5 fingers x 6 axes,
+# concatenated finger-major then axis-minor. We use q01 as `min` and q99 as
+# `max` (the percentile bounds T-Rex normalizes against). The hand slice is
+# selected in __init__ (left hand -> 0:30).
+#
+# NOTE: stats_data.json exposes these under midtrain.tactile_f6.{q01,q99}; the
+# task brief calls them tacf6_min/tacf6_max. They are the same numbers.
+_TACF6_Q01_60 = [
+    -10.828125, -0.1302490234375, -0.084228515625, -0.342529296875, -0.06048583984375, -0.1793212890625,
+    -5.5546875, -0.29443359375, -0.14599609375, -0.265625, -0.0357666015625, -0.09722900390625,
+    -4.1796875, -0.073974609375, -0.150390625, -0.253173828125, -0.029022216796875, -0.0782470703125,
+    -3.2578125, -0.4970703125, -0.199462890625, -0.211669921875, -0.033203125, -0.06414794921875,
+    -5.30859375, -0.533203125, -0.1446545124053955, -0.40283203125, -0.041229248046875, -0.0880126953125,
+    -5.73828125, -0.3701171875, -0.42578125, -0.3388671875, -0.058197021484375, -0.10162353515625,
+    -6.81640625, -0.4833984375, -0.239501953125, -0.232177734375, -0.030242919921875, -0.11358642578125,
+    -7.34375, -0.25048828125, -0.1378173828125, -0.2432861328125, -0.0265960693359375, -0.1290283203125,
+    -5.9296875, -0.220703125, -0.09442138671875, -0.1612548828125, -0.044219970703125, -0.10565185546875,
+    -3.751953125, -1.07421875, -0.43115234375, -0.200927734375, -0.039306640625, -0.059814453125,
+]
+_TACF6_Q99_60 = [
+    4.6171875, 15.6953125, 17.734375, 0.003322601318359375, 0.0195770263671875, 0.0908203125,
+    6.17578125, 11.25, 14.9296875, 0.0063018798828125, 0.026092529296875, 0.10223388671875,
+    5.3203125, 10.203125, 14.109375, 0.00618743896484375, 0.022918701171875, 0.09033203125,
+    5.55859375, 9.5390625, 12.2578125, 0.004871368408203125, 0.0218963623046875, 0.09490966796875,
+    3.724609375, 15.6796875, 27.625, 0.0089874267578125, 0.020721435546875, 0.065673828125,
+    7.43359375, 14.5078125, 18.234375, 0.01000213623046875, 0.0296478271484375, 0.1357421875,
+    3.24609375, 8.3203125, 13.4296875, 0.00894927978515625, 0.02117919921875, 0.05303955078125,
+    2.45703125, 9.34375, 13.0, 0.0064849853515625, 0.0190582275390625, 0.043182373046875,
+    2.443359375, 7.8359375, 9.265625, 0.0054168701171875, 0.0212554931640625, 0.037445068359375,
+    6.41796875, 11.15625, 10.8046875, 0.01715087890625, 0.0406494140625, 0.07781982421875,
+]
