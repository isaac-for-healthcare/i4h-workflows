+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""SaTA (Spatially-anchored Tactile Awareness) modules.
+
+Implements the per-fingertip pipeline of SaTA (arXiv 2510.14647) for the
+SharpaWave Wave01 (HB1) dexterous hand:
+    deformation maps + joint angles  -->  spatially-anchored tactile tokens.
+
+Public API:
+    SATEncoder              -- end-to-end composer, produces (B, 10, 512) tokens
+    SharpaTactileEncoder    -- frozen Sharpa DeformAE_light encoder wrapper
+    SharpaWaveFK            -- pytorch_kinematics-based bimanual FK
+    SpatialAnchor           -- Fourier + FiLM + per-finger embedding
+    FourierEncoding         -- deterministic sin/cos at frequencies 2^k
+    TRexForceEncoder        -- frozen pretrained T-Rex force VQ-VAE encoder
+
+Run ``python -m gr00t.model.modules.tactile.sat_encoder`` for a smoke test.
+"""
+from .sat_encoder import SATEncoder
+from .sharpa_encoder import SharpaTactileEncoder
+from .spatial_anchor import FourierEncoding, SpatialAnchor
+from .trex_force_encoder import TRexForceEncoder
+
+# SharpaWaveFK requires pytorch_kinematics at import time; gate it so that the
+# rest of the package is usable (e.g., for SAT smoke-testing in Mode B with
+# pre-computed poses) even before pytorch_kinematics is installed.
+try:
+    from .fk import SharpaWaveFK  # noqa: F401
+    _HAS_FK = True
+except ImportError:
+    _HAS_FK = False
+
+__all__ = [
+    "SATEncoder",
+    "SharpaTactileEncoder",
+    "SpatialAnchor",
+    "FourierEncoding",
+    "TRexForceEncoder",
+]
+if _HAS_FK:
+    __all__.append("SharpaWaveFK")
