+                step_ms = (te - prev) * 1e3 if prev is not None else 0.0
+                prev = te
+                ids = [fids[k][0] for k in keys if fids.get(k) and fids[k][0] >= 0]
+                tss = [fids[k][1] for k in keys if fids.get(k) and fids[k][1] is not None]
