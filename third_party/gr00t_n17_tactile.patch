+
+@torch.no_grad()
+def _encode_zq(vqvae: TactileVQVAE, f6: torch.Tensor) -> torch.Tensor:
+    """Quantized codebook vectors z_q for a normalized F6 window.
+
+    T-Rex's ``TactileVQVAE.encode`` returns integer code indices; this is the
+    same nearest-code lookup (``quantizer.encode_only``) followed by the
+    codebook read, so the continuous embedding can be used as a feature.
+
+    f6: [B, T, 5, 6] -> [B, 5, embed_dim] (per-finger) or [B, embed_dim] (per-hand).
+    """
+    z_e = vqvae.encoder(f6)
+    if vqvae.is_per_finger:
+        B, F, D = z_e.shape
+        idx = vqvae.quantizer.encode_only(z_e.reshape(B * F, D))  # [B*5]
+        return vqvae.quantizer.embed[idx].reshape(B, F, D)
+    idx = vqvae.quantizer.encode_only(z_e)  # [B]
+    return vqvae.quantizer.embed[idx]  # [B, D]
+
+
+class TRexForceEncoder(nn.Module):
+    """Frozen wrapper around T-Rex's pretrained force VQ-VAE.
+
+    Args:
+        num_fingers: number of fingertips this encoder serves (5 for one hand).
+            Must be a multiple of T-Rex's 5 fingers/hand; the appropriate slice
+            of the 60-d tacf6 stats is selected via ``stats_hand_offset``.
+        ckpt_path: path to T-Rex's ``model.pt`` (the full VLA checkpoint) or
+            to a state dict holding only its VQ-VAE tensors. The submodule
+            (``tactile_vqvae.encoder.*`` / ``tactile_vqvae.quantizer.*``) is
+            extracted by key prefix and loaded FROZEN; decoder tensors are
+            ignored. If ``None``, the VQ-VAE is left at random init
+            (smoke-test mode only).
+        vqvae_config: dict of TactileVQVAEConfig fields. Defaults to the
+            published checkpoint's config.
+        stats_hand_offset: which hand's 5-finger slice of the 60-d tacf6 stats
+            to use. 0 = left (axes 0:30), 1 = right (axes 30:60). Left default.
+        weight_key_prefix: prefix of the VQ-VAE submodule inside the T-Rex VLA
+            checkpoint (``self.tactile_vqvae`` -> ``"tactile_vqvae."``).
+
+    Shapes:
+        in:  ``(B, N, W, 6)`` per-finger raw force window.
+        out: ``(B, N, embed_dim)`` per-finger quantized force feature z_q.
+    """
+
+    EPS = 1e-6
+
+    def __init__(
+        self,
+        num_fingers: int,
+        ckpt_path: Optional[str | Path] = None,
+        vqvae_config: Optional[dict] = None,
+        stats_hand_offset: int = 0,
+        weight_key_prefix: str = "tactile_vqvae.",
+    ):
+        super().__init__()
+        self.num_fingers = num_fingers
+        self.weight_key_prefix = weight_key_prefix
+
+        cfg_dict = dict(DEFAULT_TREX_VQVAE_CONFIG)
+        if vqvae_config is not None:
+            cfg_dict.update(vqvae_config)
+        self.cfg = TactileVQVAEConfig.from_dict(cfg_dict)
+        self.embed_dim = self.cfg.embed_dim
+
+        # num_fingers must be a whole number of T-Rex hands (5 fingers each):
+        # the encoder is built per-hand and we slice/stack per hand below.
+        fingers_per_hand = self.cfg.n_fingers
+        if num_fingers % fingers_per_hand != 0:
+            raise ValueError(
+                f"TRexForceEncoder num_fingers={num_fingers} must be a multiple "
+                f"of T-Rex fingers/hand ({fingers_per_hand})."
+            )
+        self.num_hands = num_fingers // fingers_per_hand
+
+        self.vqvae = TactileVQVAE(self.cfg)
+        # Encode-only use: drop the decoder the public class builds so that it
+        # neither costs memory nor appears in this module's state dict (the
+        # finetuned checkpoints carry encoder + quantizer tensors only).
+        self.vqvae.decoder = nn.Identity()
+        if ckpt_path is not None:
+            self._load_vqvae_weights(ckpt_path)
+
+        # Freeze permanently (frozen pretrained module, mirrors SharpaTactileEncoder).
+        for p in self.vqvae.parameters():
+            p.requires_grad = False
+        self.vqvae.eval()
+
+        # T-Rex per-axis normalization stats, sliced to this run's hand(s).
+        # 60-d vector covers 2 hands; one hand = 30 axes (5 fingers x 6 axes).
+        n_axes = num_fingers * FORCE_AXES
+        start = stats_hand_offset * fingers_per_hand * FORCE_AXES
+        end = start + n_axes
+        if end > len(_TACF6_Q01_60):
+            raise ValueError(
+                f"Requested stats slice [{start}:{end}] exceeds the 60-d tacf6 "
+                f"stats vector (stats_hand_offset={stats_hand_offset}, "
+                f"num_fingers={num_fingers})."
+            )
+        tac_min = torch.tensor(_TACF6_Q01_60[start:end], dtype=torch.float32)
+        tac_max = torch.tensor(_TACF6_Q99_60[start:end], dtype=torch.float32)
+        # Stored as (num_fingers, 6) so they broadcast over (B, N, W, 6).
+        self.register_buffer("tacf6_min", tac_min.reshape(num_fingers, FORCE_AXES))
+        self.register_buffer("tacf6_max", tac_max.reshape(num_fingers, FORCE_AXES))
+
+    def _load_vqvae_weights(self, ckpt_path: str | Path) -> None:
+        """Extract + load the VQ-VAE submodule from a T-Rex checkpoint.
+
+        The full T-Rex ``model.pt`` stores the VQ-VAE under
+        ``self.tactile_vqvae`` -> keys ``tactile_vqvae.encoder.*`` and
+        ``tactile_vqvae.quantizer.*`` (the decoder keys, if present, are
+        ignored -- the decoder is an identity here). A file holding only
+        those tensors under the same prefix loads the same way.
+        """
+        ckpt = torch.load(ckpt_path, map_location="cpu", weights_only=False)
+        sd = ckpt.get("state_dict", ckpt) if isinstance(ckpt, dict) else ckpt
+        if not isinstance(sd, dict):
+            raise ValueError(f"Checkpoint at {ckpt_path} did not yield a state_dict")
+
+        prefix = self.weight_key_prefix
+        vq_sd = {k[len(prefix):]: v for k, v in sd.items() if k.startswith(prefix)}
+        if not vq_sd:
+            raise RuntimeError(
+                f"No keys with prefix '{prefix}' found in {ckpt_path}. "
+                f"Check the VQ-VAE submodule attribute name in the T-Rex VLA."
+            )
+        missing, unexpected = self.vqvae.load_state_dict(vq_sd, strict=False)
+        # Decoder keys are expected-unexpected (we dropped the decoder).
+        unexpected_significant = [
+            k for k in unexpected
+            if not k.startswith("decoder.") and not k.endswith("num_batches_tracked")
+        ]
+        if unexpected_significant:
+            raise RuntimeError(
+                f"Unexpected keys loading T-Rex VQ-VAE: {unexpected_significant[:5]}..."
+            )
+        missing_significant = [k for k in missing if not k.endswith("num_batches_tracked")]
+        if missing_significant:
+            raise RuntimeError(
+                f"Missing weight keys loading T-Rex VQ-VAE: {missing_significant[:5]}..."
+            )
+
+    def reset_force_params(self, ckpt_path: Optional[str | Path] = None) -> None:
+        """Re-load the frozen VQ-VAE weights after HF ``from_pretrained``.
+
+        HF's ``no_init_weights()`` under ``low_cpu_mem_usage=True`` can leave the
+        VQ-VAE's "missing" keys (when bootstrapping from a non-force checkpoint)
+        as uninitialised memory. Mirror the Sharpa DeformAE pattern: re-load the
+        pretrained weights from the checkpoint and re-freeze. If no ckpt is
+        given (smoke-test mode), nothing is reloaded -- the random init stays.
+        """
+        if ckpt_path is not None:
+            self._load_vqvae_weights(ckpt_path)
+        for p in self.vqvae.parameters():
+            p.requires_grad = False
+        self.vqvae.eval()
+
+    def train(self, mode: bool = True):  # type: ignore[override]
+        """Frozen module: ignore train() calls, stay in eval mode always."""
+        return super().train(False)
+
+    @torch.no_grad()
+    def forward(self, force_window: torch.Tensor) -> torch.Tensor:
+        """Encode a per-finger raw force window into per-finger z_q features.
+
+        Args:
+            force_window: ``(B, N, W, 6)`` RAW force (NOT pre-normalized by the
+                processor when this encoder is active -- see module docstring).
+
+        Returns:
+            ``(B, N, embed_dim)`` per-finger quantized force feature, in the
+            input dtype.
+        """
+        if force_window.dim() != 4 or force_window.shape[-1] != FORCE_AXES:
+            raise ValueError(
+                f"Expected force_window of shape (B, N, W, {FORCE_AXES}), "
+                f"got {tuple(force_window.shape)}."
+            )
+        B, N, W, A = force_window.shape
+        if N != self.num_fingers:
+            raise ValueError(
+                f"force_window has {N} fingers but this TRexForceEncoder is "
+                f"configured for num_fingers={self.num_fingers}."
+            )
+        if W != self.cfg.window:
+            raise ValueError(
+                f"force_window has W={W} frames but the T-Rex VQ-VAE was built "
+                f"for window={self.cfg.window}."
+            )
+
+        # Caller/training dtype: the raw force input arrives as fp32, but the
+        # module itself was cast to the training dtype (bf16 under mixed precision)
+        # by the Trainer. Read that dtype from a registered buffer (the VQ-VAE is
+        # about to be lazily restored to fp32, so its params no longer reflect the
+        # training dtype). z_q is cast back to this dtype so the downstream concat
+        # with the (possibly bf16) SAT token matches.
+        out_dtype = self.tacf6_min.dtype
+        x = force_window.float()
+
+        # The VQ-VAE is FROZEN and pretrained in fp32; its quantized codes depend
+        # on exact nearest-code distances, which bf16 would perturb. Under bf16
+        # training the Trainer casts the whole model (incl. these frozen params)
+        # to bf16, so lazily cast the VQ-VAE back to fp32 on first call (idempotent
+        # once already fp32). Mirrors SharpaTactileEncoder.forward. The fp32 output
+        # z_q is cast back to the caller dtype at the end so the downstream concat
+        # with the (possibly bf16) SAT token matches.
+        vq_dtype = next(self.vqvae.parameters()).dtype
+        if vq_dtype != torch.float32:
+            self.vqvae.float()
+
+        # T-Rex per-axis normalization to ~[-1, 1]: 2*(x-min)/(max-min+eps)-1.
+        # Buffers are (N, 6) -> broadcast over (B, N, W, 6).
+        # Cast buffers to fp32 too: they may have been cast to bf16 with the
+        # module, but normalization must run in fp32 to match pretrained behavior.
+        tmin = self.tacf6_min.to(device=x.device, dtype=torch.float32).view(1, N, 1, A)
+        tmax = self.tacf6_max.to(device=x.device, dtype=torch.float32).view(1, N, 1, A)
+        x = 2.0 * (x - tmin) / (tmax - tmin + self.EPS) - 1.0
+
+        fingers_per_hand = self.cfg.n_fingers
+        # Per hand: select this hand's 5 fingers, reshape to T-Rex [B, T=W, 5, 6],
+        # run the frozen encoder+quantizer, get z_q. Stack hands back to N fingers.
+        # Disable autocast so the frozen VQ-VAE convs run in fp32 (not auto-cast
+        # to the training dtype) — keeps the quantized codes identical to the
+        # pretrained fp32 behavior.
+        zq_per_hand = []
+        with torch.amp.autocast(device_type=x.device.type, enabled=False):
+            for h in range(self.num_hands):
+                sl = slice(h * fingers_per_hand, (h + 1) * fingers_per_hand)
+                # (B, 5, W, 6) -> (B, W, 5, 6)
+                f6 = x[:, sl].permute(0, 2, 1, 3).contiguous()
+                if self.vqvae.is_per_finger:
+                    zq = _encode_zq(self.vqvae, f6)          # (B, 5, embed)
+                else:
+                    # Per-hand granularity: single code per hand -> broadcast to the
+                    # 5 fingers so the downstream per-finger concat shape is uniform.
+                    zq_hand = _encode_zq(self.vqvae, f6)     # (B, embed)
+                    zq = zq_hand.unsqueeze(1).expand(B, fingers_per_hand, self.embed_dim)
+                zq_per_hand.append(zq)
+        out = torch.cat(zq_per_hand, dim=1)              # (B, N, embed)
+        return out.to(out_dtype)
+
+
+# -----------------------------------------------------------------------------
+# Smoke test: `python -m gr00t.model.modules.tactile.trex_force_encoder`
+# -----------------------------------------------------------------------------
+def _smoke_test():
+    print("=" * 70)
+    print("TRexForceEncoder smoke test (random-init VQ-VAE, no checkpoint)")
+    print("=" * 70)
+
+    B, N, W = 2, 5, 16
+    enc = TRexForceEncoder(num_fingers=N, ckpt_path=None)
+    print(f"  frozen params: {sum(p.numel() for p in enc.parameters())/1e6:.4f} M")
+    print(f"  embed_dim:     {enc.embed_dim}")
+
+    raw = torch.randn(B, N, W, FORCE_AXES) * 5.0
+    out = enc(raw)
+    print(f"  raw force in:    {tuple(raw.shape)}")
+    print(f"  z_q feature out: {tuple(out.shape)}")
+    assert out.shape == (B, N, enc.embed_dim), out.shape
+
+    # All params frozen.
+    assert all(not p.requires_grad for p in enc.parameters()), "VQ-VAE must be frozen"
+    print("  all params frozen  [OK]")
+
+    print("\nSmoke test passed.")
+
+
+if __name__ == "__main__":
+    _smoke_test()
