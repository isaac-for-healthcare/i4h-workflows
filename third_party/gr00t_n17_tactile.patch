+    def _add_joint_angles(
+        self, out: dict[str, torch.Tensor], state_data: dict[str, np.ndarray]
+    ) -> None:
+        """Add joint_angles_left / joint_angles_right (raw URDF-units) for FK.
+
+        ASSUMPTION (cannot be checked here): the state_data["left_hand"] /
+        ["right_hand"] vectors are already in the exact URDF joint order that
+        SharpaWaveFK consumes. Only the DIMENSION is validated downstream
+        (SharpaWaveFK.forward) -- a wrong ORDER passes silently and corrupts the
+        spatial anchors. We take the most recent timestep (state may have
+        multi-step history).
+        """
+        for fk_key, state_key in [
+            ("joint_angles_left", "left_hand"),
+            ("joint_angles_right", "right_hand"),
+        ]:
+            if state_key in state_data:
+                arr = state_data[state_key]
+                # arr is (dim,) for single step or (T, dim) for trajectory; take latest.
+                if arr.ndim == 2:
+                    arr = arr[-1]
+                out[fk_key] = torch.from_numpy(arr.astype(np.float32))
+
+    def _get_tactile_force_inputs(
+        self,
+        embodiment_tag: EmbodimentTag,
+        content: VLAStepData,
+        delay_delta: int | None = None,
+    ) -> dict[str, torch.Tensor]:
+        """Build the T-Rex 6-axis force window input from a VLAStepData step.
+
+        Output (when enabled): a single per-sample tensor
+
+            tactile_force   (W, 60) float32, RAW (the frozen T-Rex VQ-VAE
+                            normalizes internally with its own tacf6 stats)
+
+        where W = force_window (number of history frames, e.g. 16) and 60 = 10
+        fingers x 6 axes, in the same finger order as the deform tactile keys.
+        The data collator stacks per-sample tensors along the batch dim, so the
+        model sees action_input["tactile_force"] with shape (B, W, 60).
+
+        Returns an empty dict (preserving vanilla behavior) when:
+          * the processor was not configured with use_tactile_force=True, or
+          * the embodiment has no "tactile_force" modality registered, or
+          * content.tactile_force is None.
+
+        NOTE (out of scope here): the temporal force ENCODER and its fusion into
+        the SAT/tactile token consume this tensor downstream; this method only
+        assembles + normalizes the window onto the model input.
+        """
+        if not getattr(self, "use_tactile_force", False):
+            return {}
+        if "tactile_force" not in self.modality_configs[embodiment_tag.value]:
+            return {}
+        if content.tactile_force is None:
+            return {}
+
+        force_keys = self.modality_configs[embodiment_tag.value]["tactile_force"].modality_keys
+        # Concatenate along the feature axis if multiple keys are configured
+        # (default: single "force" key -> (W, 60)).
+        windows = []
+        for key in force_keys:
+            if key not in content.tactile_force:
+                raise KeyError(
+                    f"tactile_force key '{key}' missing from content.tactile_force "
+                    f"(available: {list(content.tactile_force.keys())})"
+                )
+            arr = np.asarray(content.tactile_force[key], dtype=np.float32)
+            if arr.ndim == 1:
+                # Single-frame fallback -> add window axis.
+                arr = arr[None, :]
+            windows.append(arr)
+        force_buf = np.concatenate(windows, axis=-1)  # (Wbuf, sum(dims)) = (Wbuf, 60)
+
+        # The window is emitted RAW (float32 cast only): the frozen T-Rex
+        # VQ-VAE normalizes internally with T-Rex's own tacf6 stats (see
+        # trex_force_encoder.py).
+        # 2-version delay augmentation: emit TWO force_window-long windows -- one
+        # ending @t (buf[0:W]) and one ending @(t+delta) (buf[delta:delta+W]) --
+        # using the delta SHARED with deform. The action head picks per-sample by
+        # tau. Clamp the shift so the window never runs past the loaded buffer.
+        if delay_delta is not None:
+            W = int(self.force_window)
+            Wbuf = force_buf.shape[0]
+            # Window ending @t: the first W frames (t sits at index W-1).
+            win_t = force_buf[0:W]
+            # Window ending @(t+delta): shift start by delta, clamped to buffer.
+            d = min(int(delay_delta), max(Wbuf - W, 0))
+            win_shift = force_buf[d : d + W]
+            return {
+                "tactile_force": torch.from_numpy(win_t.astype(np.float32)),
+                "tactile_force_shifted": torch.from_numpy(win_shift.astype(np.float32)),
+            }
+
+        # No delay-aug: emit ONLY the causal window ending at t = the first
+        # force_window frames (t sits at index force_window-1). The delay-aug
+        # modality config extends tactile_force into the FUTURE ([-15..+force_delay_max]),
+        # so returning the full buffer here would make _prepare_tactile_force take
+        # the TRAILING force_window frames = [t-11..t+force_delay_max], leaking future
+        # force into a non-delay-aug run. Slicing [0:W] here keeps the old causal
+        # [t-15..t] window -> byte-identical to the pre-delay-aug behavior.
+        W = int(self.force_window)
+        return {"tactile_force": torch.from_numpy(force_buf[0:W].astype(np.float32))}
