+++ b/gr00t/model/modules/tactile/fk.py
@@ -0,0 +1,222 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Forward kinematics for the SharpaWave dexterous hand.
+
+Computes per-fingertip 6-DoF poses (encoded as 3D position + flattened 3x3
+rotation matrix = 12D), expressed in each hand's URDF root frame (the
+"wrist reference frame" used by SaTA's spatial anchoring, per Sharpa).
+
+Bimanual layout (10 fingers total) is:
+    [left_thumb, left_index, left_middle, left_ring, left_pinky,
+     right_thumb, right_index, right_middle, right_ring, right_pinky]
+
+Pose representation per Sharpa engineers (2026-05-13): 3D position (in meters,
+matching URDF units) + 9D flattened 3x3 rotation matrix.
+"""
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import Tuple
+
+import torch
+from torch import nn
+
+try:
+    import pytorch_kinematics as pk
+except ImportError as e:  # pragma: no cover
+    raise ImportError(
+        "pytorch_kinematics is required for SharpaWaveFK. Install via:\n"
+        "    pip install -e Isaac-GR00T[tactile]\n"
+        "from the repo root inside the container."
+    ) from e
+
+
+FINGER_NAMES: Tuple[str, ...] = ("thumb", "index", "middle", "ring", "pinky")
+NUM_FINGERS_PER_HAND = 5
+NUM_FINGERS_BIMANUAL = 10
+POSE_DIM = 12  # 3D position + 9D flattened rotation matrix
+
+
+class SharpaWaveFK(nn.Module):
+    """Bimanual SharpaWave forward kinematics.
+
+    Args:
+        left_urdf_path: path to ``left_sharpa_wave.urdf`` (base variant, no
+            ``_with_wrist`` / ``_with_flange`` suffix per Sharpa's spec).
+        right_urdf_path: path to ``right_sharpa_wave.urdf``.
+
+    Shapes:
+        in:  ``(B, dof_per_hand)`` joint angle vectors, one tensor per hand.
+        out: ``(B, 10, 12)`` per-finger 12D pose in the corresponding hand's
+             wrist (URDF root) frame.
+    """
+
+    def __init__(
+        self,
+        left_urdf_path: str | Path | None = None,
+        right_urdf_path: str | Path | None = None,
+    ):
+        super().__init__()
+        if not left_urdf_path and not right_urdf_path:
+            raise ValueError(
+                "SharpaWaveFK requires at least one of left_urdf_path / right_urdf_path."
+            )
+        # A side whose URDF is not provided is left as None (single-hand mode).
+        self._left = (
+            pk.build_chain_from_urdf(Path(left_urdf_path).read_bytes())
+            if left_urdf_path
+            else None
+        )
+        self._right = (
+            pk.build_chain_from_urdf(Path(right_urdf_path).read_bytes())
+            if right_urdf_path
+            else None
+        )
+
+        # Resolve fingertip link names for each side. These must match the URDFs.
+        self._left_fingertips = tuple(f"left_{name}_fingertip" for name in FINGER_NAMES)
+        self._right_fingertips = tuple(f"right_{name}_fingertip" for name in FINGER_NAMES)
+        if self._left is not None:
+            self._verify_links(self._left, self._left_fingertips)
+        if self._right is not None:
+            self._verify_links(self._right, self._right_fingertips)
+
+        # Expose joint counts so callers can sanity-check slicing (0 if absent).
+        self.left_dof: int = (
+            len(self._left.get_joint_parameter_names()) if self._left is not None else 0
+        )
+        self.right_dof: int = (
+            len(self._right.get_joint_parameter_names()) if self._right is not None else 0
+        )
+
+        # Surface the assumed joint order in every run's log. The dataset stores
+        # hand joints as a bare vector with no joint names, so the ORDER cannot
+        # be validated at runtime -- a wrong order passes the dimension check in
+        # forward() but silently corrupts the FK poses and spatial anchors.
+        # Logging it here lets the user verify their dataset's left_hand /
+        # right_hand slice matches this URDF order. (PR review: matthewmzy.)
+        expected = self.get_expected_joint_names()
+        logging.info(
+            "[SharpaWaveFK] joint_angles_left/right MUST be in this exact URDF "
+            "joint order (no runtime name check is possible -- verify your "
+            "dataset matches):\n"
+            f"  left  ({self.left_dof}): {list(expected['left'])}\n"
+            f"  right ({self.right_dof}): {list(expected['right'])}"
+        )
+
+    def get_expected_joint_names(self) -> dict[str, tuple[str, ...]]:
+        """Return the URDF joint order that joint_angles_left/right must match.
+
+        Critical for silent-failure prevention: pytorch_kinematics expects
+        joint angles in this exact order. If your dataset stores hand joints
+        in a different order, you must remap before passing to forward().
+
+        Returns:
+            dict with keys ``"left"`` and ``"right"``, each a tuple of joint
+            names in the order this FK module consumes them. For Wave01/HB1
+            hardware this is 22 joints per hand, ordered:
+                [thumb_CMC_FE, thumb_CMC_AA, thumb_MCP_FE, thumb_MCP_AA, thumb_IP,
+                 index_MCP_FE, index_MCP_AA, index_PIP, index_DIP,
+                 middle_MCP_FE, middle_MCP_AA, middle_PIP, middle_DIP,
+                 ring_MCP_FE, ring_MCP_AA, ring_PIP, ring_DIP,
+                 pinky_CMC, pinky_MCP_FE, pinky_MCP_AA, pinky_PIP, pinky_DIP]
+        """
+        return {
+            "left": tuple(self._left.get_joint_parameter_names())
+            if self._left is not None
+            else (),
+            "right": tuple(self._right.get_joint_parameter_names())
+            if self._right is not None
+            else (),
+        }
+
+    @staticmethod
+    def _verify_links(chain: "pk.Chain", expected: Tuple[str, ...]) -> None:
+        present = set(chain.get_link_names())
+        missing = [n for n in expected if n not in present]
+        if missing:
+            raise ValueError(
+                f"Expected fingertip links not found in URDF: {missing}. "
+                f"Available link names start with: {sorted(present)[:8]}..."
+            )
+
+    def _to(self, device: torch.device, dtype: torch.dtype):
+        # pytorch_kinematics chains are stateful and need to be moved to device.
+        # Re-`.to` is cheap if already there.
+        if self._left is not None:
+            self._left = self._left.to(dtype=dtype, device=device)
+        if self._right is not None:
+            self._right = self._right.to(dtype=dtype, device=device)
+
+    def _fingertip_poses(
+        self,
+        chain: "pk.Chain",
+        joint_angles: torch.Tensor,
+        fingertip_names: Tuple[str, ...],
+    ) -> torch.Tensor:
+        """Run FK on one hand's chain.
+
+        Returns: ``(B, 5, 12)`` -- per-fingertip 12D pose in that chain's root frame.
+        """
+        # forward_kinematics returns a dict[link_name -> Transform3d].
+        # The Transform3d batched matrix is (B, 4, 4).
+        results = chain.forward_kinematics(joint_angles)
+        out = []
+        for name in fingertip_names:
+            mat = results[name].get_matrix()  # (B, 4, 4)
+            position = mat[..., :3, 3]                       # (B, 3)
+            rotation = mat[..., :3, :3].reshape(*mat.shape[:-2], 9)  # (B, 9)
+            out.append(torch.cat([position, rotation], dim=-1))      # (B, 12)
+        return torch.stack(out, dim=1)  # (B, 5, 12)
+
+    def forward(
+        self,
+        joint_angles_left: torch.Tensor | None = None,
+        joint_angles_right: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Compute per-finger pose vectors for the provided hand(s).
+
+        Args:
+            joint_angles_left:  ``(B, left_dof)``  in URDF joint order, or None.
+            joint_angles_right: ``(B, right_dof)`` in URDF joint order, or None.
+
+        Returns:
+            ``(B, 5*num_present, 12)`` -- bimanual finger order is
+            [LT, LI, LM, LR, LP, RT, RI, RM, RR, RP]; single-hand returns just
+            that hand's 5 fingers. Each side's fingers are in its own wrist frame.
+        """
+        if joint_angles_left is None and joint_angles_right is None:
+            raise ValueError(
+                "SharpaWaveFK.forward requires at least one of "
+                "joint_angles_left / joint_angles_right."
+            )
+        if joint_angles_left is not None and self._left is None:
+            raise ValueError("joint_angles_left provided but no left URDF was loaded.")
+        if joint_angles_right is not None and self._right is None:
+            raise ValueError("joint_angles_right provided but no right URDF was loaded.")
+
+        # Move chain(s) to match the input tensor's device/dtype.
+        ref = joint_angles_left if joint_angles_left is not None else joint_angles_right
+        self._to(ref.device, ref.dtype)
+
+        poses = []
+        if joint_angles_left is not None:
+            if joint_angles_left.shape[-1] != self.left_dof:
+                raise ValueError(
+                    f"joint_angles_left has dim {joint_angles_left.shape[-1]}, "
+                    f"chain expects {self.left_dof}"
+                )
+            poses.append(
+                self._fingertip_poses(self._left, joint_angles_left, self._left_fingertips)
+            )
+        if joint_angles_right is not None:
+            if joint_angles_right.shape[-1] != self.right_dof:
+                raise ValueError(
+                    f"joint_angles_right has dim {joint_angles_right.shape[-1]}, "
+                    f"chain expects {self.right_dof}"
+                )
+            poses.append(
+                self._fingertip_poses(self._right, joint_angles_right, self._right_fingertips)
+            )
+        return torch.cat(poses, dim=1)  # (B, 5*num_present, 12)
