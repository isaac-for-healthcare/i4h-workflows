+def _setup_high_freq_tactile(server: PolicyServer, policy, config: ServerConfig) -> None:
+    """Override the server's get_action endpoint so each request re-encodes the
+    SAT tactile tokens from the FRESHEST tactile before every denoising step.
+
+    A background ZMQ subscriber holds the latest tactile frame per finger; a
+    `tactile_input_provider` closure snapshots it on each call (the action head
+    invokes the provider once per denoise step) and returns a `deform_maps`
+    tensor matching the dataset transform: per-finger (1, H, W) float32, NO
+    normalization, stacked to (B=1, N, 1, 240, 240), then cast to the model's
+    device/dtype.
+
+    The provider ALSO returns fresh joint_angles_left/right when the stream
+    carries them (the bridge attaches each fingertip frame's contemporaneous
+    hand pose, in DEGREES; we convert to radians to match read_hand_state / the
+    FK). This keeps the SaTA FK pose time-aligned with the deform it anchors,
+    instead of reusing the staler joints from the request observation. When the
+    stream has no joints for a hand (legacy bridge / no data yet), that hand's
+    joints fall back to the request observation via the action-head merge.
+    """
+    import numpy as np
+    import torch
+
+    # Direct `run_gr00t_server.py` invocation bypasses launch_deploy.sh's guards,
+    # so re-validate here. high-freq tactile needs (a) a tactile checkpoint — a
+    # vanilla ckpt has no "tactile" modality and would KeyError below — and (b) a
+    # model to re-encode through — a ReplayPolicy has no .model.
+    if "tactile" not in getattr(policy, "modality_configs", {}):
+        raise ValueError(
+            "--high-freq-tactile requires a tactile checkpoint, but the loaded "
+            "policy has no 'tactile' modality. Load a tactile Gr00tN1d7 checkpoint."
+        )
+    if getattr(policy, "model", None) is None:
+        raise ValueError(
+            "--high-freq-tactile requires a model-backed policy (Gr00tPolicy); the "
+            "loaded policy has no .model (e.g. ReplayPolicy)."
+        )
+    if config.tactile_refresh not in ("per-step", "once"):
+        raise ValueError(
+            f"--tactile-refresh must be 'per-step' or 'once'; got {config.tactile_refresh!r}."
+        )
+
+    if config.tactile_utils_dir:
+        sys.path.insert(0, config.tactile_utils_dir)
+    from utils.sharpa_tactile_subscriber import SharpaTactile_Subscriber
+
+    # Fingers (and order) come from the checkpoint's tactile modality keys, e.g.
+    # "left_thumb_deform" -> (hand="left", finger="thumb"). This is the exact
+    # order _compute_tactile_features expects along dim=1.
+    tactile_keys = policy.modality_configs["tactile"].modality_keys
+    finger_specs = []  # list of (hand, finger) e.g. ("left", "thumb")
+    for k in tactile_keys:
+        parts = k.split("_")  # ["left", "thumb", "deform"]
+        finger_specs.append((parts[0], parts[1]))
+
