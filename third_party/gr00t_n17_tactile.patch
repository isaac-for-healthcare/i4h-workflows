+                    f"{hand}: deg[{qd.min():.1f},{qd.max():.1f}] -> rad[{qr.min():.2f},{qr.max():.2f}]"
+                )
+            print(
+                f"  High-freq tactile: first snapshot — {live}/{len(finger_specs)} "
+                f"fingers had live frames ({'LIVE STREAM OK' if live else 'EMPTY → zero-filled, check stream/host/port'})"
+                f"; joints {joints_live} (False => fell back to obs joints; "
+                f"check bridge emits the joint trailer / --state-hz); "
+                f"{' | '.join(jmsg)}",
+                flush=True,
+            )
+        return fresh, fids
+
+    def provider():
+        t_enter = _time.perf_counter()
+        if refresh_once and inflight["fresh"] is not None:
+            fresh, fids = inflight["fresh"], inflight["fids"]  # reuse this inference's snapshot
+        else:
+            fresh, fids = _build_fresh()
