index 0000000..fd38293
--- /dev/null
+++ b/tests/gr00t/model/test_tactile_force_flow.py
@@ -0,0 +1,203 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Fast repro for the tactile-force shape-mismatch crash.
+
+Reproduces (and now guards against) the step-0 crash in the DiT tactile
+cross-attention ``to_k``:
+
+    RuntimeError: mat1 and mat2 shapes cannot be multiplied (10x512 and 768x1536)
+
+Root cause: ``Gr00tN1d7Processor.from_pretrained`` dropped the
+``use_tactile_force`` override kwarg (it was not in the ``override_keys``
+allowlist). A tactile-force finetune sets ``start_from_checkpoint``, so
+setup.py builds the processor via ``from_pretrained(...)`` -- the base
+checkpoint's saved config has ``use_tactile_force=False``, so the processor
+stayed force-off and emitted no ``tactile_force``. The tactile token stayed 512
+while the DiT cross-attn KV was widened to base+force (768), hence the matmul
+mismatch.
+
+The T-Rex force VQ-VAE is built RANDOM-INIT here (``ckpt_path=None`` -- legal
+at module level, no 8GB model.pt needed) to isolate the data->model wiring.
+Run in the `gr00t` conda env.
+"""
+
+import json
+import shutil
+from pathlib import Path
+
+import numpy as np
+import pytest
+import torch
+
+from gr00t.data.embodiment_tags import EmbodimentTag
+from gr00t.data.types import ModalityConfig, VLAStepData
+
+FIXTURE_DIR = Path(__file__).parent.parent.parent / "fixtures" / "processor_config"
+EMBODIMENT = "libero_sim"
+FORCE_WINDOW = 16
+NUM_FINGERS = 10  # 10 fingers x 6 axes = 60-wide force feature
+BASE_TACTILE_DIM = 512
+TREX_EMBED_DIM = 256  # published T-Rex VQ-VAE embed_dim
+
+
+def _force_modality_config() -> ModalityConfig:
+    return ModalityConfig(
+        delta_indices=list(range(-(FORCE_WINDOW - 1), 1)),  # [-15..0] -> W=16
+        modality_keys=["force"],
+    )
+
+
+def _build_processor(use_tactile_force: bool, fixture_dir: Path = FIXTURE_DIR):
+    """Build the processor the way setup.py does on the start_from_checkpoint
+    path: AutoProcessor/Processor.from_pretrained(base, use_tactile_force=...)."""
+    from unittest.mock import MagicMock, patch
+
+    from gr00t.model.gr00t_n1d7.processing_gr00t_n1d7 import Gr00tN1d7Processor
+
+    mock_vlm = MagicMock()
+    mock_vlm.tokenizer.padding_side = "left"
+    with patch(
+        "gr00t.model.gr00t_n1d7.processing_gr00t_n1d7.build_processor",
+        return_value=mock_vlm,
+    ):
+        proc = Gr00tN1d7Processor.from_pretrained(
+            fixture_dir,
+            use_tactile_force=use_tactile_force,
+            force_window=FORCE_WINDOW,
+        )
+    proc.eval()
+    # Register a tactile_force modality for this embodiment (the base fixture has
+    # none); mirrors what the tactile finetune's modality_configs would add.
+    if use_tactile_force:
+        proc.modality_configs[EMBODIMENT]["tactile_force"] = _force_modality_config()
+    return proc
+
+
+def _make_step_with_force() -> VLAStepData:
+    # RAW 6-axis force window: (W, 60). Use non-trivial magnitudes so a
+    # missing/zeroed emit would be visibly wrong.
+    force = (np.random.randn(FORCE_WINDOW, NUM_FINGERS * 6) * 5.0).astype(np.float32)
+    return VLAStepData(
+        images={},
+        states={},
+        actions={},
+        text="pick up the apple",
+        embodiment=EmbodimentTag(EMBODIMENT),
+        tactile_force={"force": force},
+    )
+
+
+# --------------------------------------------------------------------------
+# (1) ROOT-CAUSE GUARD: from_pretrained must honor the force overrides.
+# --------------------------------------------------------------------------
+def test_from_pretrained_honors_force_overrides():
+    """Before the fix these overrides were silently dropped -> force-off."""
+    proc = _build_processor(use_tactile_force=True)
+    assert proc.use_tactile_force is True, (
+        "from_pretrained dropped use_tactile_force override -> processor stays "
+        "force-off -> no tactile_force emitted -> 512-vs-768 matmul crash."
+    )
+    assert proc.force_window == FORCE_WINDOW
+
+
+def test_from_pretrained_drops_legacy_force_encoder_type(tmp_path):
+    """Checkpoints saved before the continuous encoder was removed serialize
+    force_encoder_type into processor_kwargs; __init__ no longer accepts it, so
+    from_pretrained must pop the stale key instead of raising TypeError."""
+    legacy_dir = tmp_path / "legacy_processor"
+    shutil.copytree(FIXTURE_DIR, legacy_dir)
+    config_file = legacy_dir / "processor_config.json"
+    config = json.loads(config_file.read_text())
+    config["processor_kwargs"]["force_encoder_type"] = "trex_vqvae"
+    config_file.write_text(json.dumps(config))
+
+    proc = _build_processor(use_tactile_force=True, fixture_dir=legacy_dir)
+    assert not hasattr(proc, "force_encoder_type")
+
+
+# --------------------------------------------------------------------------
+# (2) Processor emits tactile_force, RAW (the frozen T-Rex VQ-VAE
+#     normalizes internally with its own tacf6 stats).
+# --------------------------------------------------------------------------
+def test_processor_emits_raw_force():
+    proc = _build_processor(use_tactile_force=True)
+    step = _make_step_with_force()
+    out = proc._get_tactile_force_inputs(step.embodiment, step)
+    assert "tactile_force" in out, "processor failed to emit tactile_force"
+    t = out["tactile_force"]
+    assert tuple(t.shape) == (FORCE_WINDOW, NUM_FINGERS * 6)
+    # RAW (un-normalized) passthrough.
+    np.testing.assert_allclose(t.numpy(), step.tactile_force["force"], rtol=0, atol=0)
+
+
+def test_deform_only_emits_nothing():
+    """use_tactile_force=False -> empty dict (vanilla/SaTA path unchanged)."""
+    proc = _build_processor(use_tactile_force=False)
+    step = _make_step_with_force()
+    out = proc._get_tactile_force_inputs(step.embodiment, step)
+    assert out == {}, "deform-only path must not emit tactile_force"
+
+
+# --------------------------------------------------------------------------
+# (3) Token dim == cross-attn KV dim (no matmul mismatch).
+# --------------------------------------------------------------------------
+class _Cfg:
+    """Minimal stand-in for the model config consumed by _resolve_force_feat_dim."""
+
+    def __init__(self, use_tactile_force):
+        self.use_tactile_force = use_tactile_force
+        self.tactile_feature_dim = BASE_TACTILE_DIM
+        self.trex_vqvae_config = None  # matches real checkpoints (None, not {})
+
+
+@pytest.mark.gpu
+def test_sat_token_dim_equals_cross_attn_dim():
+    """SATEncoder fused-token width == base + _resolve_force_feat_dim (768)."""
+    from gr00t.model.gr00t_n1d7.gr00t_n1d7 import _resolve_force_feat_dim
+    from gr00t.model.modules.tactile import SATEncoder
+
+    cfg = _Cfg(use_tactile_force=True)
+    cross_attn_dim = BASE_TACTILE_DIM + _resolve_force_feat_dim(cfg)
+    assert cross_attn_dim == BASE_TACTILE_DIM + TREX_EMBED_DIM
+
+    # ckpt_path=None -> random-init T-Rex VQ-VAE (legal outside training).
+    enc = SATEncoder(
+        num_fingers=NUM_FINGERS,
+        feat_dim=BASE_TACTILE_DIM,
+        use_tactile_force=True,
+    )
+    token_dim = enc.fused_tactile_dim
+    assert token_dim == cross_attn_dim, (
+        f"tactile token dim {token_dim} != cross-attn KV dim {cross_attn_dim} "
+        f"-> matmul mismatch"
+    )
+
+    # Forward the force path end-to-end (random-init VQ-VAE, frozen).
+    B = 2
+    force = torch.randn(B, NUM_FINGERS, FORCE_WINDOW, 6)
+    feat = enc.force_encoder(force)  # (B, N, Df)
+    assert feat.shape == (B, NUM_FINGERS, TREX_EMBED_DIM)
+    assert all(not p.requires_grad for p in enc.force_encoder.parameters())
+
+
+@pytest.mark.gpu
+def test_sat_token_dim_deform_only_unchanged():
+    """Force off -> token dim stays base (512); _resolve returns 0."""
+    from gr00t.model.gr00t_n1d7.gr00t_n1d7 import _resolve_force_feat_dim
+    from gr00t.model.modules.tactile import SATEncoder
+
+    cfg = _Cfg(use_tactile_force=False)
+    assert _resolve_force_feat_dim(cfg) == 0
+
+    enc = SATEncoder(num_fingers=NUM_FINGERS, feat_dim=BASE_TACTILE_DIM, use_tactile_force=False)
+    assert enc.fused_tactile_dim == BASE_TACTILE_DIM
+    assert enc.force_encoder is None
+
+
+if __name__ == "__main__":
+    # Lightweight CPU-only run (skips the SATEncoder gpu tests that build the
+    # Sharpa encoder). Exercises the root-cause guard + emit assertions.
+    test_from_pretrained_honors_force_overrides()
+    test_processor_emits_raw_force()
+    test_deform_only_emits_nothing()
+    print("OK: processor honors force overrides and emits RAW tactile_force; "
+          "deform-only path unchanged.")
