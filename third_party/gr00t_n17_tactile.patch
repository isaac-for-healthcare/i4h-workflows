+    _p = next(policy.model.parameters())
+    dev, dt = _p.device, _p.dtype
+    zero = np.zeros((H, W), dtype=np.float32)  # missing finger -> baseline (no contact)
+
+    sub = SharpaTactile_Subscriber(host=config.tactile_host, port=config.tactile_port)
+    # flush=True: the server's stdout is line-buffered into a redirected log and
+    # only flushes on clean exit, so without this the confirmation is invisible.
+    print(
+        f"  High-freq tactile: SUB tcp://{config.tactile_host}:{config.tactile_port}; "
+        f"per-step fingers={['_'.join(s) for s in finger_specs]}",
+        flush=True,
+    )
+
+    import time as _time
+
+    refresh_once = config.tactile_refresh == "once"
