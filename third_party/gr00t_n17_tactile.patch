+def _setup_cascade(server: PolicyServer, policy, config: ServerConfig) -> None:
+    """Wire the slow/fast inference cascade onto the get_action endpoint.
+
+    The cascade orchestration itself lives in Gr00tN1d7.get_action (it holds the
+    per-model {backbone_output, slow_cache, counter} cache). This wrapper just (a)
+    validates the checkpoint is a delay-aug tactile ckpt (the cascade is only
+    in-distribution there), (b) logs the startup summary + drift guard, and (c)
+    threads the cascade flags through `options` on every request. The freshness
+    comes from each client obs (the async RTC worker captures fresh tactile per
+    call); no live subscriber is required for the cascade.
+    """
+    # Direct invocation bypasses launch_deploy.sh guards; re-validate here.
+    if getattr(policy, "model", None) is None:
+        raise ValueError(
+            "--cascade requires a model-backed policy (Gr00tPolicy); the loaded "
+            "policy has no .model (e.g. ReplayPolicy)."
+        )
+    model_cfg = getattr(policy.model, "config", None)
+    use_tactile = bool(getattr(model_cfg, "use_tactile", False))
+    delay_aug = bool(getattr(model_cfg, "delay_aug", False))
+    if not use_tactile:
+        raise ValueError(
+            "--cascade requires a tactile checkpoint (use_tactile=True), but the "
+            "loaded checkpoint has use_tactile=False."
+        )
+    if not delay_aug:
+        raise ValueError(
+            "--cascade requires a DELAY-AUG-trained checkpoint (delay_aug=True): "
+            "the cascade feeds the FAST tail tactile that LEADS the VL, which is "
+            "only in-distribution for a delay-aug ckpt. The loaded checkpoint has "
+            "delay_aug=False. Retrain with delay_aug, or drop --cascade."
+        )
+    if config.high_freq_tactile:
+        raise ValueError(
+            "--cascade is incompatible with --high-freq-tactile: the cascade caches "
+            "the VL + slow-denoise state across K get_action calls and refreshes "
+            "tactile per call from the obs (deform + force), whereas --high-freq-tactile "
+            "refreshes per denoise step via a live subscriber -- which the cascade fast "
