@@ -0,0 +1,139 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Tactile-enabled Gr00t N1.7 config.
+
+Subclass of Gr00tN1d7Config that:
+  * enables the SaTA tactile path (use_tactile=True)
+  * adds tactile-specific fields (encoder ckpt path, URDFs, dims)
+  * applies the GR00T-team-recommended finetune overrides for the tactile
+    workflow: state_dropout_prob 0.8 -> 0.5, tune_visual False -> True.
+
+These tactile-specific changes stay out of Gr00tN1d7Config so vanilla GR00T
+users are unaffected, and future upstream syncs don't conflict on these fields.
+"""
+from dataclasses import MISSING, dataclass
+from typing import Optional
+
+from . import register_model_config
+from .gr00t_n1d7 import Gr00tN1d7Config
+
+
+@dataclass
+class Gr00tN1d7TactileConfig(Gr00tN1d7Config):
+    """Tactile-enabled variant of Gr00tN1d7Config.
+
+    Hardware target: SharpaWave Wave01 (HB1) bimanual hand, 10 fingertips,
+    240x240 single-channel deformation maps, 22 DoF per hand.
+    """
+    # Distinct model_type so HF AutoConfig can register both vanilla and tactile.
+    model_type: str = "Gr00tN1d7Tactile"
+
+    # Master switch for the SaTA tactile path.
+    use_tactile: bool = True
+
+    # Trainability of the new tactile modules. Uses param-name filter on
+    # the substring "tactile" inside Gr00tN1d7ActionHead.set_trainable_parameters.
+    tune_tactile: bool = True
+
+    # Sharpa HB1 DeformAE_light encoder feature dim (per finger).
+    tactile_feature_dim: int = 512
+
+    # Number of fingertips total (5 per hand x 2 hands).
+    num_tactile_tokens: int = 10
+
+    # --- T-Rex high-frequency 6-axis tactile FORCE path ----------------------
+    # Master switch for wiring the per-frame 6-axis force history window
+    # (observation.tactile.force, 60 = 10 fingers x 6 axes) through the data
+    # pipeline onto the model input as action_input["tactile_force"] of shape
+    # (B, force_window, 60). DATA-PIPELINE ONLY for now: the temporal force
+    # encoder + fusion into the SAT/tactile token are later phases. Default
+    # False so existing SaTA runs are unaffected until the force dataset exists.
+    use_tactile_force: bool = False
+    # Number of history frames in the force window. Must match the count of the
+    # "tactile_force" modality delta_indices in the modality config
+    # (e.g. range(-15, 1) -> 16).
+    force_window: int = 16
+
+    # --- Force encoder: T-Rex's PRETRAINED force VQ-VAE, loaded FROZEN --------
+    # Emits per-finger quantized codebook vectors z_q (width = the checkpoint's
+    # embed_dim, default 256). The force feature is CONCATENATED onto the SAT
+    # tactile token (token width = tactile_feature_dim + force_feat_dim); the
+    # DiT tactile cross-attn KV dim is widened to match, and day-0 behavior ==
+    # deform-only via the zero-init of the DiT tactile cross-attn OUTPUT
+    # projection (gr00t/model/modules/dit.py).
+    # Path to T-Rex's model.pt (the VLA checkpoint). The VQ-VAE submodule
+    # (tactile_vqvae.encoder.* / tactile_vqvae.quantizer.*) is extracted by key
+    # prefix and loaded FROZEN. Leave None to build a random-init VQ-VAE (smoke
+    # tests only). DEFERRED: download via
+    #   huggingface_hub.hf_hub_download(
+    #       repo_id="miniFranka/T-Rex_midtrain_mecka23k_ucb100_vqvae_epoch6",
+    #       filename="model.pt")
+    trex_vqvae_ckpt_path: Optional[str] = None
+    # Optional TactileVQVAEConfig field overrides. None -> the published
+    # checkpoint's config (granularity="finger", codebook_size=64, embed_dim=256,
+    # window=16, n_fingers=5, per_finger_dim=6).
+    trex_vqvae_config: Optional[dict] = None
+    # Which hand's 5-finger slice of the 60-d tacf6 normalization stats to use:
+    # 0 = left hand (axes 0:30), 1 = right hand (axes 30:60). Left default
+    # (matches the single-hand left finetune workflow).
+    trex_stats_hand_offset: int = 0
+
+    # --- tau-conditioned delay augmentation (deform + force) + tactile dropout -
+    # TRAINING-ONLY. GR00T flow-matching runs tau=0 (noise) -> tau=1 (data), so
+    # HIGH-tau are the FINAL refined denoise steps. HIGH-tau (tau >= tau_split)
+    # steps see FRESH tactile at t+delta against context held at t; LOW-tau (early)
+    # steps see synced tactile (delta=0). The 2-version scheme shifts BOTH deform
+    # and force by a SHARED per-sample delta (VL + the action target stay @t). The
+    # loader supplies buffers longer than the window (e.g. deform delta_indices
+    # range(0, 5) = 5 frames, force range(-15, 5) = 20 = 16 history + 4 future);
+    # the transform emits @t and @(t+delta) versions and the action head picks
+    # per-sample by tau. delta=0 -> @t == today's synced behavior.
+    delay_aug: bool = False
+    # Per-sample tau threshold: tau >= tau_split -> delta in [0, force_delay_max]
+    # (FRESH, final steps); tau < tau_split -> delta=0 (synced, early steps).
+    tau_split: float = 0.5
+    # Max per-sample delay delta (inclusive) for HIGH-tau samples. The key knob.
+    # Must be <= the number of FUTURE frames the loader provides (e.g. 16 for force
+    # delta_indices range(-15, 17)). The processor guards this against the modality
+    # config and fails loudly on a mismatch.
+    force_delay_max: int = 16
+    # Per-sample probability of zeroing the fused tactile tokens (deform+force
+    # together) so the model learns a VL-only fallback. Independent of delay_aug.
+    tactile_dropout_prob: float = 0.1
+
+    # Sharpa HB1 DeformAE_light checkpoint -- only deform_encoder.* keys loaded.
+    # Leave None to skip weight loading (random init -- useful only for smoke tests).
+    sharpa_encoder_ckpt_path: Optional[str] = None
+
+    # SharpaWave URDFs for forward kinematics. Required when use_tactile=True
+    # unless the caller pre-computes poses externally.
+    sharpa_left_urdf_path: Optional[str] = None
+    sharpa_right_urdf_path: Optional[str] = None
+
+    # GR00T team finetune recommendations for the tactile workflow.
+    # These override the vanilla Gr00tN1d7Config defaults.
+    state_dropout_prob: float = 0.5   # vanilla default: 0.8
+    tune_visual: bool = True          # vanilla default: False
+
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        # Parent's __init__ used ITS dataclass defaults for the inherited
+        # fields. Re-apply our subclass's overrides for any field that the
+        # caller didn't explicitly pass via kwargs.
+        for f in self.__class__.__dataclass_fields__.values():
+            if f.name in kwargs:
+                continue
+            if f.default is not MISSING:
+                setattr(self, f.name, f.default)
+        # tau_split partitions the denoise schedule (low-tau synced / high-tau
+        # fresh) for delay-aug training AND the slow/fast cascade split. The
+        # endpoints are legal (0.0 = every step fresh, 1.0 = every step
+        # synced); anything outside [0, 1] can never match a flow-matching
+        # time and silently degenerates both phases.
+        if not (0.0 <= float(self.tau_split) <= 1.0):
+            raise ValueError(
+                f"tau_split must be within [0, 1]; got {self.tau_split!r}."
+            )
+
+
+register_model_config("Gr00tN1d7Tactile", Gr00tN1d7TactileConfig)
