             ensure_assets_registered()
         return key in self._components
 
+    def is_registered_local(self, key: str) -> bool:
+        """Check the current registry without importing the global asset catalog."""
+        return key in self._components
+
     def get_component_by_name(self, key: str) -> Any:
         """Get an component by name.
 
@@ -84,8 +88,15 @@ class AssetRegistry(Registry):
         Args:
             name (str): The name of the asset.
         """
-        ensure_assets_registered()
-        return self.get_component_by_name(name)
+        # Workflow-owned assets register themselves before scene construction.
+        # Return those entries without importing the network-backed global
+        # catalog, which may be unavailable in offline simulation runs.
+        if name in self._components:
+            return self._components[name]
+        ensure_assets_registered()
+        if name not in self._components:
+            raise AssertionError(f"component {name} not found, please check if requested component is registered")
+        return self._components[name]
 
