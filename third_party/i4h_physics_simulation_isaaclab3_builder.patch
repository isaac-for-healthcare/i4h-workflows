+def _finalized_builder():
+    """The ModelBuilder IsaacLab finalized, or None.
+
+    IsaacLab 3.0 keeps it in the SimulationContext's backend registry; earlier
+    releases held it on ``NewtonManager._builder``.
+    """
+    builder = getattr(NewtonManager, "_builder", None)
+    if builder is not None:
+        return builder
+    try:
+        from isaaclab.sim import SimulationContext
+        from isaaclab_newton.physics import NewtonBuilderCfg
+    except ImportError:
+        return None
+    sim = SimulationContext.instance()
+    if sim is None:
+        return None
+    return sim.get_or_create_backend(NewtonBuilderCfg(physics_cfg=sim.cfg.physics))
+
+
+def _per_env_world_mask(world_mask, num_envs: int):
+    """The per-environment part of a Newton world mask.
+
+    IsaacLab 3.0 appends a slot for Newton's global world (-1) to the mask it hands
+    solver resets; the rod and its coupler own per-environment state only.
+    """
+    if world_mask is not None and len(world_mask) == num_envs + 1:
+        return world_mask[:num_envs]
+    return world_mask
+
