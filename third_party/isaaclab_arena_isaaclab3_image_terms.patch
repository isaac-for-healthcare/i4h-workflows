+def _image_term(data_type: str) -> type:
+    """Isaac Lab 3.0 GA image term for a camera data type (``mdp.image`` was split by modality)."""
+    from isaaclab.utils.images import is_depth_like, is_normals_like, is_rgb_like
+
+    if is_rgb_like(data_type):
+        return mdp.image_rgb
+    if is_depth_like(data_type):
+        return mdp.image_depth
+    if is_normals_like(data_type):
+        return mdp.image_normals
+    if "segmentation" in data_type:
+        return mdp.image_segmentation
+    raise ValueError(f"No Isaac Lab image observation term reads camera data type '{data_type}'.")
+
