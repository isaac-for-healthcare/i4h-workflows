# Build and installation
build/
build-*/
install/
install-*/
dist/
_CPack_Packages/

# Data
data/

# Utilities and metadata
aggregate_metadata.json

# CI
ci/

# Python bytecode and generated package metadata. These recursive rules keep
# host artifacts out of every COPY, including the final `COPY . .`.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.tox/
**/.nox/
**/*.egg-info/
**/.coverage
**/.coverage.*
**/coverage.xml
**/htmlcov/

# Development environment
**/.venv/
.vscode-server/
ngc-cli/
CTestConfig.cmake

# Cache and temporary directories
.cache/
.cupy/
.cmake/
.docker/
.config/
.local/
tmp/
.run/
runs/

# History and user files
.bash_history
.python_history
.wget-hsts
.viminfo
.lesshst

# Version control
.git/
.gitignore
.github/

# Setup-managed sources are cloned at their pinned revisions inside the image.
# Never send local third-party worktrees through the Docker build context.
third_party/*
!third_party/setup.sh
!third_party/*.patch
